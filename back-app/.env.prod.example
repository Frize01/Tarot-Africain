APP_NAME="Tarot Africain"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tarot.tom-bury.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de données (service "db") ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tarot
DB_USERNAME=tarot
DB_PASSWORD=__CHANGE_ME__

# --- Session / cache / queue en base ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=tarot.tom-bury.fr
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Broadcasting Reverb (serveur -> service "reverb" en interne) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=tarot-prod
REVERB_APP_KEY=tarot-prod-key
REVERB_APP_SECRET=__CHANGE_ME__
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Auth SPA (front même domaine) ---
SANCTUM_STATEFUL_DOMAINS=tarot.tom-bury.fr
