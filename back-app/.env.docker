APP_NAME="Tarot Africain"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Base de données (service "db" dans docker-compose) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=tarot
DB_USERNAME=tarot
DB_PASSWORD=secret

# --- Session / cache / queue : stockés en base (tables migrées) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# --- Broadcasting via Reverb ---
BROADCAST_CONNECTION=reverb

# Le backend (API) parle au service "reverb" par son nom de service
REVERB_APP_ID=local-app
REVERB_APP_KEY=local-dev-key
REVERB_APP_SECRET=local-dev-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Le serveur Reverb écoute sur toutes les interfaces du conteneur
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- Auth SPA (front sur localhost:9999) ---
SANCTUM_STATEFUL_DOMAINS=localhost:9999,localhost:8000,127.0.0.1:9999
SESSION_DOMAIN=localhost
