# Build de PRODUCTION (vite build). Valeurs publiques (embarquées dans le bundle).
# Front servi par Caddy sur le même domaine que l'API → appels relatifs (pas de CORS).
VITE_API_ROOT=
# Reverb via Caddy en wss sur le domaine public (port 443)
VITE_REVERB_APP_KEY=tarot-prod-key
VITE_REVERB_HOST=tarot.tom-bury.fr
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
